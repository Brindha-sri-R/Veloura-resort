# Veloura Client Environment Variables
# Copy this file to .env to configure local environment settings

# Google OAuth 2.0 Web Client ID
# Obtain this from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID (Web Application)
# Add Authorized JavaScript origins: http://localhost:3000 and https://veloura-resort.vercel.app
VITE_GOOGLE_CLIENT_ID=

# API Base URL (leave blank in development to use the Vite proxy /api -> http://localhost:5000/api)
VITE_API_URL=
